{
  "appId": "in.gov.uk.floodflash",
  "appName": "FloodFlash Citizen Emergency",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#050505",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#050505"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_siren",
      "iconColor": "#bd1e1e",
      "sound": "alarm.wav"
    }
  }
}
